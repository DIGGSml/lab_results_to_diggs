    {
     "name": "drying_temperature_c",
     "required": false,
     "doc": "Oven temperature, degC"
    }
   ],
   "examples": [
    [
     "B-1",
     "S-1",
     "2.5",
     "4",
     "split spoon",
     "12.4",
     "110"
    ],
    [
     "B-1",
     "S-2",
     "5",
     "6.5",
     "split spoon",
     "18.9",
     ""
    ]
   ]
  },
  {
   "id": "atterberg_limits",
   "title": "Atterberg limits",
   "sheet": "Atterberg Limits",
   "astm": "ASTM D4318",
   "optional": false,
   "keyed": true,
   "notes": "",
   "columns": [
    {
     "name": "liquid_limit",
     "required": false,
     "doc": "LL (whole number)",
     "min": 0
