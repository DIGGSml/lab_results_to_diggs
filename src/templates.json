    "key": "client",
    "setting": "client",
    "label": "Client",
    "doc": "Optional.",
    "example": "Example Engineering, Inc."
   },
   {
    "key": "laboratory",
    "setting": "labName",
    "label": "Laboratory",
    "doc": "Your laboratory name.",
