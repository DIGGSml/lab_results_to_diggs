      "wet",
      "dry"
     ],
     "strict": true
    },
    {
     "name": "ll_method",
     "required": false,
     "doc": "multipoint or one_point",
     "choices": [
      "multipoint",
      "one_point"
     ],
     "strict": true
    }
   ],
   "examples": [
