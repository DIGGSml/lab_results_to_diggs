  {
   "id": "gradation",
   "title": "Gradation (sieve + hydrometer)",
   "sheet": "Gradation",
   "astm": "ASTM D6913 / D7928 / D422, USCS D2487",
   "optional": false,
   "keyed": true,
   "notes": "One row per sieve or hydrometer point. Percent gravel, sand, silt, clay, D-values, Cu, Cc and the USCS classification are computed; USCS also uses the Atterberg limits of the same sample.",
   "columns": [
    {
     "name": "standard",
     "required": false,
     "doc": "Blank = D6913 (+ D7928 hydrometer); or D422",
     "choices": [
      "D6913",
      "D422"
     ],
     "strict": true
    },
    {
     "name": "method",
     "required": true,
     "doc": "sieve or hydrometer",
     "choices": [
      "sieve",
      "hydrometer"
     ],
     "strict": true
    },
    {
     "name": "sieve",
     "required": false,
     "doc": "Sieve designation, e.g. No. 40 or 3/4 in",
     "text": true,
     "width": 11,
     "choices": [
      "3 in",
      "2 in",
      "1-1/2 in",
      "1 in",
      "3/4 in",
      "1/2 in",
      "3/8 in",
      "No. 4",
      "No. 10",
      "No. 20",
      "No. 40",
      "No. 60",
      "No. 100",
      "No. 140",
      "No. 200"
     ],
     "strict": false
    },
    {
     "name": "particle_size_mm",
     "required": false,
     "doc": "Opening or particle diameter, mm (required for hydrometer rows)",
     "min": 0
    },
    {
     "name": "percent_passing",
     "required": true,
     "doc": "Percent passing / finer",
     "min": 0,
     "max": 100
    },
    {
     "name": "uscs_symbol",
     "required": false,
     "doc": "Optional reported USCS symbol (overrides the computed one)",
