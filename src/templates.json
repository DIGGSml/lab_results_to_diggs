{
 "key_columns": [
  {
   "name": "boring_id",
   "required": true,
   "doc": "Boring / test pit ID, exactly as on the logs",
   "text": true,
   "width": 12,
   "lookup": "borings"
  },
  {
   "name": "sample_id",
   "required": true,
   "doc": "Sample ID within the boring (e.g. S-3, ST-2, B-1)",
   "text": true,
   "width": 11
  },
  {
   "name": "top_depth",
   "required": true,
   "doc": "Top of sample, below ground surface",
   "min": 0
  },
  {
   "name": "bottom_depth",
   "required": false,
   "doc": "Bottom of sample; blank for a point sample",
   "min": 0
  },
  {
   "name": "sample_type",
   "required": false,
   "doc": "e.g. split spoon, Shelby tube, bulk",
   "text": true,
   "width": 16,
   "choices": [
    "split spoon",
    "Shelby tube",
    "bulk",
    "grab",
    "piston",
    "ring-lined barrel",
    "rock core",
    "block"
   ],
   "strict": false
  }
 ],
 "templates": [
  {
   "id": "borings",
   "title": "Borings",
   "sheet": "Borings",
   "astm": "",
   "optional": true,
   "keyed": false,
   "notes": "Gives each boring a map location. Without latitude, longitude and elevation the file still passes the schema and codelist checks, but the business-rule check reports one geometry error per boring.",
   "columns": [
    {
     "name": "boring_id",
     "required": true,
     "doc": "Boring ID used in the results files",
     "text": true,
     "width": 12
    },
    {
     "name": "latitude",
     "required": false,
     "doc": "Decimal degrees, WGS84",
     "min": -90,
     "max": 90
    },
    {
     "name": "longitude",
     "required": false,
     "doc": "Decimal degrees, WGS84 (negative for west)",
     "min": -180,
     "max": 180
    },
    {
     "name": "ground_elevation",
     "required": false,
     "doc": "Ground surface elevation, NAVD88, in the depth unit"
    },
    {
     "name": "total_depth",
     "required": false,
     "doc": "Total depth of the boring",
     "min": 0
    },
    {
     "name": "date_drilled",
     "required": false,
     "doc": "YYYY-MM-DD",
     "text": true,
     "width": 13
    }
   ],
   "examples": [
    [
     "B-1",
     "35.780200",
     "-78.640100",
     "310.5",
     "30",
     "2026-06-01"
    ],
    [
     "B-2",
     "35.780700",
     "-78.639600",
     "308.2",
     "25",
     "2026-06-02"
    ]
   ]
  },
  {
   "id": "samples",
   "title": "Samples",
   "sheet": "Samples",
   "astm": "",
   "optional": true,
   "keyed": true,
   "notes": "Lists samples received, including ones with no tests. Samples in the results files are added automatically.",
   "columns": [],
   "examples": [
    [
     "B-1",
     "S-1",
     "2.5",
     "4",
     "split spoon"
    ],
    [
     "B-1",
     "ST-3",
     "10",
     "12",
     "Shelby tube"
    ]
   ]
  },
  {
   "id": "water_content",
   "title": "Water content",
   "sheet": "Water Content",
   "astm": "ASTM D2216",
   "optional": false,
   "keyed": true,
   "notes": "",
   "columns": [
    {
     "name": "water_content_pct",
     "required": true,
     "doc": "Water content, %",
     "min": 0
